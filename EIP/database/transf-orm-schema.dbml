// Transf-ORM — Schéma DB
// A coller sur https://dbdiagram.io pour visualiser

Table users {
  id                UUID [pk, default: `gen_random_uuid()`]
  email             varchar(255) [not null, unique]
  password_hash     varchar(255) [not null]
  name              varchar(255)
  email_verified_at timestamptz
  created_at        timestamptz [not null, default: `now()`]
  updated_at        timestamptz [not null, default: `now()`]
}

Table refresh_tokens {
  id          UUID [pk, default: `gen_random_uuid()`]
  user_id     UUID [not null, ref: > users.id]
  token_hash  varchar(255) [not null]
  expires_at  timestamptz [not null]
  created_at  timestamptz [not null, default: `now()`]
}

Table teams {
  id         UUID [pk, default: `gen_random_uuid()`]
  name       varchar(255) [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table team_members {
  id        UUID [pk, default: `gen_random_uuid()`]
  team_id   UUID [not null, ref: > teams.id]
  user_id   UUID [not null, ref: > users.id]
  role      team_role [not null, default: 'member']
  joined_at timestamptz [not null, default: `now()`]

  indexes {
    (team_id, user_id) [unique]
  }

  Note: 'Un seul owner par team : index partiel unique WHERE role = owner (non exprimable en DBML, à ajouter en migration SQL)'
}

Table invitations {
  id          UUID [pk, default: `gen_random_uuid()`]
  team_id     UUID [not null, ref: > teams.id]
  email       varchar(255) [not null]
  role        team_role [not null, default: 'member']
  invited_by  UUID [not null, ref: > users.id]
  token       varchar(255) [not null, unique]
  status      invitation_status [not null, default: 'pending']
  expires_at  timestamptz [not null]
  created_at  timestamptz [not null, default: `now()`]
}

Table plans {
  id              UUID [pk, default: `gen_random_uuid()`]
  slug            varchar(50) [not null, unique]
  name            varchar(100) [not null]
  max_projects    integer [not null]
  max_members     integer [not null]
  price_cents     integer [not null]
  stripe_price_id varchar(255)
}

Table subscriptions {
  id                     UUID [pk, default: `gen_random_uuid()`]
  team_id                UUID [not null, unique, ref: > teams.id]
  plan_id                UUID [not null, ref: > plans.id]
  status                 subscription_status [not null, default: 'active']
  stripe_customer_id     varchar(255)
  stripe_subscription_id varchar(255)
  current_period_end     timestamptz
  created_at             timestamptz [not null, default: `now()`]
  updated_at             timestamptz [not null, default: `now()`]
}

Table orms {
  id   UUID [pk, default: `gen_random_uuid()`]
  slug varchar(50) [not null, unique]
  name varchar(100) [not null]
}

Table projects {
  id          UUID [pk, default: `gen_random_uuid()`]
  team_id     UUID [not null, ref: > teams.id]
  name        varchar(255) [not null]
  description text
  created_by  UUID [not null, ref: > users.id]
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]
}

Table project_collaborators {
  id         UUID [pk, default: `gen_random_uuid()`]
  project_id UUID [not null, ref: > projects.id]
  user_id    UUID [not null, ref: > users.id]
  added_by   UUID [not null, ref: > users.id]
  added_at   timestamptz [not null, default: `now()`]

  indexes {
    (project_id, user_id) [unique]
  }
}

Table schema_files {
  id          UUID [pk, default: `gen_random_uuid()`]
  project_id  UUID [not null, ref: > projects.id]
  orm_id      UUID [ref: > orms.id]
  filename    varchar(255) [not null]
  path        varchar(1024) [not null]
  source      file_source [not null, default: 'upload']
  uploaded_by UUID [ref: > users.id]
  created_at  timestamptz [not null, default: `now()`]
}

Table file_versions {
  id             UUID [pk, default: `gen_random_uuid()`]
  file_id        UUID [not null, ref: > schema_files.id]
  version_number integer [not null]
  storage_key    varchar(1024) [not null]
  content        text [note: 'utilisé seulement si stockage direct en DB (MVP)']
  origin         version_origin [not null]
  created_by     UUID [ref: > users.id]
  job_id         UUID [ref: > transform_jobs.id]
  created_at     timestamptz [not null, default: `now()`]

  indexes {
    (file_id, version_number) [unique]
  }
}

Table transform_jobs {
  id           UUID [pk, default: `gen_random_uuid()`]
  project_id   UUID [not null, ref: > projects.id]
  from_orm_id  UUID [ref: > orms.id]
  to_orm_id    UUID [not null, ref: > orms.id]
  description  text
  status       job_status [not null, default: 'pending']
  requested_by UUID [not null, ref: > users.id]
  started_at   timestamptz
  finished_at  timestamptz
  created_at   timestamptz [not null, default: `now()`]
}

Table transform_job_files {
  id                 UUID [pk, default: `gen_random_uuid()`]
  job_id             UUID [not null, ref: > transform_jobs.id]
  file_id            UUID [not null, ref: > schema_files.id]
  result             job_file_result
  suggestion         text [note: 'piste proposée si pas de traduction exacte']
  error_message      text
  output_version_id  UUID [ref: > file_versions.id]
}

Table git_integrations {
  id                      UUID [pk, default: `gen_random_uuid()`]
  team_id                 UUID [not null, ref: > teams.id]
  provider                git_provider [not null]
  access_token_encrypted  text [not null]
  refresh_token_encrypted text
  connected_by            UUID [not null, ref: > users.id]
  connected_at            timestamptz [not null, default: `now()`]

  indexes {
    (team_id, provider) [unique]
  }
}

Table project_repo_links {
  id             UUID [pk, default: `gen_random_uuid()`]
  project_id     UUID [not null, unique, ref: > projects.id]
  integration_id UUID [not null, ref: > git_integrations.id]
  repo_full_name varchar(255) [not null]
  branch         varchar(255) [not null, default: 'main']
  auto_import    boolean [not null, default: false]
  linked_at      timestamptz [not null, default: `now()`]
}

Table pull_requests {
  id              UUID [pk, default: `gen_random_uuid()`]
  project_id      UUID [not null, ref: > projects.id]
  job_id          UUID [ref: > transform_jobs.id]
  provider_pr_id  varchar(255) [not null]
  url             varchar(1024) [not null]
  status          pr_status [not null, default: 'open']
  created_at      timestamptz [not null, default: `now()`]
}

// Enums

Enum team_role {
  owner
  admin
  member
}

Enum invitation_status {
  pending
  accepted
  expired
  revoked
}

Enum subscription_status {
  active
  past_due
  canceled
  trialing
}

Enum file_source {
  upload
  repo_import
}

Enum version_origin {
  upload
  transform
  revert
  repo_sync
}

Enum job_status {
  pending
  running
  partial
  done
  failed
  canceled
}

Enum job_file_result {
  success
  partial
  unsupported
  error
}

Enum git_provider {
  github
  gitlab
  bitbucket
}

Enum pr_status {
  open
  merged
  closed
}
